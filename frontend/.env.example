# 前端环境变量示例 —— 复制为 .env.local 并按需填写（真实值不外泄、不入 Git）

# Supabase 前端（仅 anon/publishable key，禁止 service_role key）
# 项目 URL 示例：https://nmbkxbldxauvgsbdsljj.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 后端 API 地址
VITE_API_BASE_URL=https://ai-music-backend-db6h.onrender.com
VITE_WS_BASE=wss://ai-music-backend-db6h.onrender.com

# Frontend Sentry（公开客户端 DSN）
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production