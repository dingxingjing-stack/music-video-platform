# Music Video Platform - Environment Variables
# Copy this file to .env and fill in your values

# AI Services — 正式架构：fal.ai 为主力，Gemini/Agnes 为文本
FAL_KEY=your-fal-key-here
FAL_MODEL=fal-ai/stable-audio
FAL_TIMEOUT=300
# 开发备用
GEMINI_API_KEY=your-gemini-api-key-here
# 旧链路（可选保留作兜底，正式建议移除）
# MUREKA_API_KEY=sk-your-api-key-here

# Application
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database — 生产为 Supabase PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# R2 — 正式商用必需（与 Fal 同级）
# CLOUDFLARE_R2_ACCOUNT_ID=xxx
# CLOUDFLARE_R2_ACCESS_KEY=xxx
# CLOUDFLARE_R2_SECRET_KEY=xxx
# CDN_BUCKET=music-audio-storage
# CDN_BASE_URL=https://cdn.yourdomain.com

# 预算硬线（新键兼容旧 MODAL_BUDGET_DAILY）
# FAL_BUDGET_DAILY=30

# File Storage
UPLOAD_DIR=./uploads
RESULTS_DIR=./results

# Security (optional)
# JWT_SECRET=your-secret-key-here
# SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=info

# Rate Limiting (requests per minute)
RATE_LIMIT=60