# HeartMuLa HF Spaces - Docker Ignore
# 排除不需要构建进镜像的文件

# 模型权重（运行时从 HF Hub 下载，不打包进镜像）
*.safetensors
*.bin
*.pt
*.pth
model.safetensors.index.json
config.json
tokenizer.json
gen_config.json

# 模型缓存目录
/models/
/checkpoints/
/pretrained/
*.cache/
__pycache__/
*.pyc

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo

# 环境变量和密钥
.env
.env.*
*.local.json
secrets.*
*.key
*.pem

# 日志和输出
*.log
*.out
*.txt
!requirements*.txt
!README*

# 测试文件
test_*.py
*_test.py
tests/
__pycache__/
.pytest_cache/
.coverage

# 前端构建产物（不需要）
frontend-web/static_dist/
frontend/dist/
frontend/node_modules/

# 大文件
*.wav
*.mp3
*.mp4
*.avi
*.mov
*.zip
*.tar.gz

# 部署相关（其他平台配置）
modal_*.py
deploy_*.py
render.yaml
docker-compose.yml
Dockerfile
Dockerfile.*
kaggle_*
*.ipynb

# 文档
docs/
*.md
!README.md

# 临时文件
tmp/
temp/
*.tmp
*.bak