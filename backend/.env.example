# ─── 数据库配置 ───────────────────────────────────────

# PostgreSQL (生产环境 — Supabase 必需，Koyeb 无状态环境禁止 SQLite)
# Supabase 示例（需替换为你的 Supabase 连接串，带 sslmode=require）：
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://hermes:hermes_password@localhost:5432/hermes_platform
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_password
POSTGRES_DB=hermes_platform
# Supabase/生产强制 PG：ENVIRONMENT=production 时若 DATABASE_URL 仍为 sqlite 将直接报错
ENVIRONMENT=development

# 连接池配置（仅 PostgreSQL 生效）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# CDN 配置 (Cloudflare R2) — Step 3 统一（CDN_BUCKET 主，R2_BUCKET_NAME 仅兼容旧）
CDN_BASE_URL=https://cdn.hermes-platform.com
CDN_BUCKET=hermes-audio-platform
# R2_BUCKET_NAME=hermes-audio-platform  # deprecated alias，仅旧部署兼容
CLOUDFLARE_R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
CLOUDFLARE_R2_SECRET_KEY=YOUR_R2_SECRET_KEY

# ─── RunPod Serverless 音乐生成（Step 6 正式商用主力，替代 Fal） ───────────
RUNPOD_API_KEY=YOUR_RUNPOD_API_KEY
RUNPOD_ENDPOINT_ID=YOUR_ENDPOINT_ID
RUNPOD_TIMEOUT=300
RUNPOD_POLL_INTERVAL=2
# GPU 预算硬线（新键，兼容旧 FAL_BUDGET_DAILY）
RUNPOD_BUDGET_DAILY=30

# ─── Fal.ai 音乐生成（备用，Step 1 正式商用） ───────────
FAL_KEY=YOUR_FAL_KEY
# 兼容旧键
FAL_API_KEY=YOUR_FAL_KEY
FAL_MODEL=fal-ai/stable-audio
FAL_TIMEOUT=300
FAL_POLL_INTERVAL=2
# GPU 预算硬线（Step 4: 统一 FAL_BUDGET_DAILY，旧 MODAL_BUDGET_DAILY deprecated 仅兼容读取）
FAL_BUDGET_DAILY=30
# MODAL_BUDGET_DAILY deprecated — 生产不再配置

# ─── 现有配置 ───────────────────────────────────────

# Gemini API 密钥
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Mureka API（Phase API-2B 生产 PRIMARY 音乐生成，需自行申请 API Key）
MUREKA_API_KEY=YOUR_MUREKA_API_KEY
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_MODEL=auto
MUREKA_TIMEOUT_SECONDS=300
MUREKA_POLL_INTERVAL_SECONDS=3

# Mureka 中国区 API（api.mureka.cn，选配 —— 真实 Key 只填 backend/.env，此处仅占位）
MUREKA_CN_API_KEY=YOUR_MUREKA_CN_API_KEY

# ─── Yinchao 音潮（生产第一 Provider，需自行申请 API Key）───────────
# 真实 Key 只填 backend/.env 或 Render 环境变量，此处仅占位，不填真 Key。
YINCHAO_API_KEY=YOUR_YINCHAO_API_KEY
YINCHAO_API_BASE_URL=https://open.yinchaoyongxian.com
YINCHAO_TIMEOUT_SECONDS=240
YINCHAO_POLL_INTERVAL_SECONDS=3

# ─── Tempolor 天普大模型（生产第二 Provider，需自行申请 API Key）────
# 真实 Key 只填 backend/.env 或 Render 环境变量，此处仅占位，不填真 Key。
TEMPOLOR_API_KEY=YOUR_TEMPOLOR_API_KEY
TEMPOLOR_BASE_URL=https://api.tianpuyue.cn
TEMPOLOR_MODEL=tempolor-latest
TEMPOLOR_TIMEOUT_SECONDS=360
TEMPOLOR_POLL_INTERVAL_SECONDS=3
# Tempolor 官方 callback_url 为必填字段；轮询模式下仍需传值，结果以 query 轮询为准。
TEMPOLOR_CALLBACK_URL=YOUR_TEMPOLOR_CALLBACK_URL

# RunwayML API 密钥 (P3-2 AI 特效)
RUNWAYML_API_KEY=YOUR_RUNWAYML_API_KEY

# 服务器配置
HOST=0.0.0.0
PORT=8001

# JWT 配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# TTS 后端模式
TTS_BACKEND_MODE=mock
WORKFLOW_MODE=mock

# 隐私模式
PRIVACY_MODE=false

# ─── 其他服务 ───────────────────────────────────────

# Creatomate API (MV 生成)
CREATOMATE_API_KEY=YOUR_CREATOMATE_KEY
CREATOMATE_TEMPLATE_ID=ad45bcc0-11c0-4a85-bd00-27f74bde332e

# NVIDIA NVAPI (可选)
NVAPI_KEY=YOUR_NVAPI_KEY

# 文件上传限制
MAX_UPLOAD_SIZE_MB=100

# 日志级别
LOG_LEVEL=INFO

# ── P0 安全收口新增项（全部默认关闭 / fail-closed，不配就等于功能不可用）──
# 管理员端点令牌：未设置则 POST /api/v1/auth/credits/add 返回 503
# 真实值只写入 .env / Render 环境变量，禁止提交
ADMIN_API_TOKEN=<placeholder>
# 订阅支付回调 HMAC-SHA256 密钥：未设置则 POST /api/v1/subscription/webhook 返回 503
SUBSCRIPTION_WEBHOOK_SECRET=<placeholder>
# RunPod 连通性冒烟端点总开关：不设或非 true 则该端点对外表现为 404
# 生产方向不使用 RunPod 出歌，此项仅内部诊断时临时开启
ENABLE_RUNPOD_SMOKE_TEST=false
# GET /api/v1/audio/trim 的额外可信媒体主机（逗号分隔；默认白名单已含 R2 与自有 CDN 域）
AUDIO_TRIM_EXTRA_HOSTS=

# ── 积分补充包（Paddle Billing v2，一次性购买）────────────────────────
# 全部未配置时：GET /api/v1/credits/packs 返回空列表、POST /checkout 返回 503、
# POST /paddle/webhook 返回 503（fail-closed，绝不发放 Credits）。
# 真实值只写入 .env / Render 环境变量，禁止提交。
# 运行环境：sandbox | production（决定调 https://sandbox-api.paddle.com 还是 api.paddle.com）
PADDLE_ENV=sandbox
# Paddle 服务端 API Key（沙箱 pdl_sdbx_apikey_... / 生产 pdl_live_apikey_...）：
# 用于服务端建单与客户门户会话，未设置则不能下单
PADDLE_API_KEY=<placeholder>
# Paddle.js 客户端 token（test_... / live_...）：仅前端初始化用，由后端 /packs 透传
PADDLE_CLIENT_TOKEN=<placeholder>
# Webhook Alert 的 secret key（pdl_ntfset_...），逗号分隔可填多个以支持密钥轮换：
# 未设置则 webhook 一律 503
PADDLE_WEBHOOK_SECRET=<placeholder>
# 签名时间戳容差（秒），默认 300；设 0 关闭该检查（不建议）
PADDLE_WEBHOOK_MAX_AGE_SECONDS=300
# 一次性积分包的 Paddle Price ID（pri_...）。积分数量写在后端
# （app/services/credits_config.py 的 CREDIT_PACKS），此处只登记 Price ID。
# 未填的包不会出现在前端。
PADDLE_PRICE_ID_CREDITS_200=
PADDLE_PRICE_ID_CREDITS_500=
PADDLE_PRICE_ID_CREDITS_1200=
PADDLE_PRICE_ID_CREDITS_2800=
# 会员订阅（Recurring / Monthly）的 Paddle Price ID。价格与每月积分数写在后端
# （credits_config.MEMBERSHIP_PLANS = Starter 4.99/200、Basic 9.99/500、
#  Pro 19.99/1200、Creator 39.99/2800），此处只登记 Price ID；未填的计划不出现在 /plans。
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_BASIC=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_CREATOR=

# ── 履约 / 客户门户（复用上面的键，不新增 Secret）─────────────────────
# 客户与订阅镜像表 paddle_customers / paddle_subscriptions 由启动时的 init_db()
# 自动创建，不需要手工 DDL。写入路径只有已验签的 webhook。
# POST /api/v1/credits/portal-session 用 PADDLE_API_KEY 铸造门户会话，
# 因此该 key 还需要 Customer 的读写范围；customer id 一律由服务端镜像反查，
# 请求体不接受任何 ctre_ 参数。
# 注意：PADDLE_WEBHOOK_SECRET 是 Notification Destination 的 endpoint secret
# （pdl_ntfset_...），与 PADDLE_API_KEY 是两个不同的值，混用会导致每次验签都失败。

# ── Lemon Squeezy（新增 provider，与 Paddle 并存；阶段一只做服务端建单）──────
# 全部真实值只写入 backend/.env，禁止提交。未配齐下面三项时
# POST /api/v1/credits/lemonsqueezy/checkout 一律 503，前端自动继续走 Paddle。
# API Key：LS 后台 Settings → API，分 live / test 两种；test key 只碰 test 数据。
# 官方要求此 key 只能待在服务端（不得出现在 client-side code）。
LEMONSQUEEZY_API_KEY=
# Store ID：纯数字，出现在 /api/v1/stores 响应里，用于 JSON:API relationships。
LEMONSQUEEZY_STORE_ID=
# Webhook 签名密钥：由我们自己生成（官方建议 6–40 字符随机串），LS 用它对原始
# body 做 HMAC-SHA256 hexdigest 并放进 X-Signature 头。阶段一尚未启用验签逻辑。
LEMONSQUEEZY_WEBHOOK_SECRET=
# 支付完成后 LS Hosted Checkout 的跳转回站地址（可选，留空则不覆盖商品默认值）。
LEMONSQUEEZY_REDIRECT_URL=
# 各条目的 Lemon Squeezy Variant ID（LS 的价格挂在 variant 上）。
# 积分数量与金额仍只在 app/services/credits_config.py 里定义，此处只登记映射；
# 未填的条目不会走 Lemon Squeezy 链路。
LEMONSQUEEZY_VARIANT_ID_CREDITS_200=
LEMONSQUEEZY_VARIANT_ID_CREDITS_500=
LEMONSQUEEZY_VARIANT_ID_CREDITS_1200=
LEMONSQUEEZY_VARIANT_ID_CREDITS_2800=
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_BASIC=
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_CREATOR=
