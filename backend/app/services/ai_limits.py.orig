"""AI 生成额度 / 成本保护 / 下载审计 —— 集中配置与存储（公测第一版）。

所有公测限制常量集中在此文件，供 ai_music 路由与前端统一读取。
配额数据复用现有 SQLite 数据库（backend/data/beta.db，与 beta_service.py
同一文件），新增三张表，不触碰 beta 现有表：
  - generation_usage : 每用户每日/每月生成计数
  - global_usage     : 全平台每日生成计数（成本保护硬线）
  - download_logs    : 下载审计日志（user_id / job_id / file_type / 时间 / IP）

安全说明（公测安全限制）：
  - 当前登录为 localStorage user_id 伪登录，无真实 token。
  - 后端以请求头 X-User-ID 绑定任务归属，并做任务级归属校验（IDOR 防护），
    但 X-User-ID 本身可被伪造 —— 因此下载仍通过短期预签名 URL + 每用户限流
    缓解，且对象不公开读。真实鉴权（JWT/OAuth）为后续升级项，见交付说明。
"""

from __future__ import annotations

import os
import sqlite3
import threading
import time
from typing import Any, Optional

# ═══════════════════════════════════════════════════════════════════════
# 集中配置（可用环境变量覆盖，默认值 = 公测第一版）
# ═══════════════════════════════════════════════════════════════════════
DAILY_GENERATION_LIMIT = int(os.getenv("DAILY_GENERATION_LIMIT", "1"))
MONTHLY_GENERATION_LIMIT = int(os.getenv("MONTHLY_GENERATION_LIMIT", "15"))
GLOBAL_DAILY_GENERATION_LIMIT = int(os.getenv("GLOBAL_DAILY_GENERATION_LIMIT", "30"))
MAX_AUDIO_DURATION_SECONDS = int(os.getenv("MAX_AUDIO_DURATION_SECONDS", "180"))
MAX_CONCURRENT_JOBS_PER_USER = int(os.getenv("MAX_CONCURRENT_JOBS_PER_USER", "1"))
MAX_AUTO_RETRIES = int(os.getenv("MAX_AUTO_RETRIES", "1"))
MAX_TASK_RUNTIME_SECONDS = int(os.getenv("MAX_TASK_RUNTIME_SECONDS", "600"))

# 下载限流：每用户窗口内最大下载次数
DOWNLOAD_RATE_LIMIT = int(os.getenv("DOWNLOAD_RATE_LIMIT", "10"))
DOWNLOAD_RATE_WINDOW_SECONDS = int(os.getenv("DOWNLOAD_RATE_WINDOW_SECONDS", "3600"))

# GPU 预算硬停线（服务端硬限制，非前端提示）。
# 代理指标：以「今日已启动生成次数」（global_usage 计数，GPU 启动前原子占用、
# 只增不减）近似当日 GPU 成本，单位：次/天。
# 误差说明：这不是精确计费——真实费用取决于 GPU 冷启动、模型加载与实际运行时长
# （单任务上限 MAX_TASK_RUNTIME_SECONDS=600s，音频时长 MAX_AUDIO_DURATION_SECONDS=180s）；
# 本代理取「启动次数」为保守上限，宁严勿松，不声称可精确核算费用。
# 达到后：新生成（Fal/ACE-Step）与 retry-stems（Demucs）均被拒绝，不启动任何新 GPU 任务。
# 留空表示不启用该硬停线。
# 兼容旧键 MODAL_BUDGET_DAILY，新架构推荐 FAL_BUDGET_DAILY / GPU_BUDGET_DAILY
MODAL_BUDGET_DAILY = os.getenv("FAL_BUDGET_DAILY") or os.getenv("GPU_BUDGET_DAILY") or os.getenv("MODAL_BUDGET_DAILY", "")

_DB_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "data")
_DB_PATH = os.path.join(_DB_DIR, "beta.db")

_DB_LOCK = threading.Lock()


def _get_conn() -> sqlite3.Connection:
    os.makedirs(_DB_DIR, exist_ok=True)
    conn = sqlite3.connect(_DB_PATH, timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    _init_db(conn)
    return conn


def check_and_log_download(user_id: str, job_id: str, file_type: str, ip_address: str = "") -> bool:
    """
    原子检查并记录下载：同一事务内检查 1 小时窗口计数，< DOWNLOAD_RATE_LIMIT 则记录并放行，>= 则拒绝。

    返回 True=放行，False=超限（429）。
    """
    if not user_id:
        return True
    conn = _get_conn()
    try:
        conn.execute("BEGIN IMMEDIATE")
        # 1. 清理过期记录（可选，保持表瘦身）
        cutoff = time.time() - DOWNLOAD_RATE_WINDOW_SECONDS
        conn.execute("""
            DELETE FROM download_logs
            WHERE user_id = ? AND created_at < datetime(?, 'unixepoch')
        """, (user_id, cutoff))

        # 2. 当前窗口计数
        count = conn.execute("""
            SELECT COUNT(*) FROM download_logs
            WHERE user_id = ? AND created_at > datetime(?, 'unixepoch')
        """, (user_id, cutoff)).fetchone()[0]

        if count >= DOWNLOAD_RATE_LIMIT:
            conn.rollback()
            return False

        # 3. 同事务记录本次下载
        conn.execute("""
            INSERT INTO download_logs (user_id, job_id, file_type, ip_address)
            VALUES (?, ?, ?, ?)
        """, (user_id, job_id, file_type, ip_address or ""))

        conn.commit()
        return True
    finally:
        conn.close()


def _today() -> str:
    import datetime
    return datetime.date.today().isoformat()


def _month_key() -> str:
    import datetime
    return datetime.date.today().strftime("%Y-%m")


def budget_daily_limit() -> Optional[int]:
    """返回每日 GPU 预算（次/天）；未配置或非法返回 None（不启用）。"""
    if not MODAL_BUDGET_DAILY:
        return None
    try:
        return max(int(MODAL_BUDGET_DAILY), 0)
    except (TypeError, ValueError):
        return None


def budget_hard_stop_reached() -> bool:
    """GPU 预算硬停线是否已触发（今日 global_usage 计数 >= 预算）。

    供 retry-stems（Demucs GPU）等非「生成」入口复用，确保达到预算后不启动任何新 GPU。
    """
    lim = budget_daily_limit()
    if lim is None:
        return False
    today = _today()
    with _DB_LOCK:
        conn = _get_conn()
        try:
            g = conn.execute("SELECT count FROM global_usage WHERE date=?", (today,)).fetchone()
            return bool(g and g["count"] >= lim)
        finally:
            conn.close()


def _get_conn() -> sqlite3.Connection:
    os.makedirs(_DB_DIR, exist_ok=True)
    conn = sqlite3.connect(_DB_PATH, timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    _init_db(conn)
    return conn


def _init_db(conn: sqlite3.Connection) -> None:
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS generation_usage (
            user_id TEXT PRIMARY KEY,
            date TEXT NOT NULL,
            daily_count INTEGER NOT NULL DEFAULT 0,
            month_key TEXT NOT NULL,
            monthly_count INTEGER NOT NULL DEFAULT 0,
            updated_at TEXT DEFAULT (datetime('now'))
        );
        CREATE TABLE IF NOT EXISTS global_usage (
            date TEXT PRIMARY KEY,
            count INTEGER NOT NULL DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS download_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id TEXT NOT NULL,
            job_id TEXT NOT NULL,
            file_type TEXT NOT NULL,
            ip_address TEXT DEFAULT '',
            created_at TEXT DEFAULT (datetime('now'))
        );
    """)


# ═══════════════════════════════════════════════════════════════════════
# 原子预留 / 退款（在真正启动 Modal GPU 之前调用）
# ═══════════════════════════════════════════════════════════════════════
def reserve_generation(user_id: str) -> dict[str, Any]:
    """原子预留一次生成额度。

    同时校验并占用量（不可通过刷新/重复 POST/改 localStorage 绕过，因为计数在服务端）：
      - 每用户每日 <= DAILY_GENERATION_LIMIT
      - 每用户每月 <= MONTHLY_GENERATION_LIMIT
      - 全平台每日 <= GLOBAL_DAILY_GENERATION_LIMIT（全局成本保护）
      - 若配置 MODAL_BUDGET_DAILY，按启动次数近似预算硬停线
    全局计数使用「单条条件自增 SQL」原子占用，并发/重复请求无法越过硬线。
    返回 {"success": True, ...} 或 {"success": False, "error": str}。
    """
    if not user_id:
        return {"success": False, "error": "缺少用户标识（X-User-ID）"}
    today, mkey = _today(), _month_key()
    budget_lim = budget_daily_limit()
    cap = GLOBAL_DAILY_GENERATION_LIMIT
    if budget_lim is not None and budget_lim < cap:
        cap = budget_lim

    with _DB_LOCK:
        conn = _get_conn()
        try:
            # 用户级每日 / 每月（先检查，不占用全局计数）
            row = conn.execute("SELECT * FROM generation_usage WHERE user_id=?", (user_id,)).fetchone()
            daily = 0
            monthly = 0
            if row:
                daily = row["daily_count"] if row["date"] == today else 0
                monthly = row["monthly_count"] if row["month_key"] == mkey else 0
            if daily >= DAILY_GENERATION_LIMIT:
                return {"success": False, "error": f"今日生成额度已用完（{daily}/{DAILY_GENERATION_LIMIT}），请明天再试"}
            if monthly >= MONTHLY_GENERATION_LIMIT:
                return {"success": False, "error": f"本月生成额度已用完（{monthly}/{MONTHLY_GENERATION_LIMIT}）"}

            # 原子全局成本门：条件自增，达到任一硬线则 0 行变更（并发安全）
            conn.execute(
                "INSERT INTO global_usage (date, count) VALUES (?, 0) ON CONFLICT(date) DO NOTHING",
                (today,),
            )
            cur = conn.execute(
                "UPDATE global_usage SET count = count + 1 WHERE date = ? AND count < ?",
                (today, cap),
            )
            if cur.rowcount == 0:
                g = conn.execute("SELECT count FROM global_usage WHERE date=?", (today,)).fetchone()
                gcount = g["count"] if g else 0
                if budget_lim is not None and gcount >= budget_lim:
                    return {"success": False, "error": "今日 GPU 预算已用尽，请明天再试"}
                return {"success": False, "error": "今日全平台生成已达上限，请明天再试"}

            g = conn.execute("SELECT count FROM global_usage WHERE date=?", (today,)).fetchone()
            gcount = g["count"] if g else 1

            # 原子占用量
            conn.execute(
                """INSERT INTO generation_usage (user_id, date, daily_count, month_key, monthly_count)
                   VALUES (?,?,?,?,?)
                   ON CONFLICT(user_id) DO UPDATE SET
                     date=excluded.date,
                     daily_count=CASE WHEN generation_usage.date=excluded.date
                                     THEN generation_usage.daily_count+1 ELSE 1 END,
                     month_key=excluded.month_key,
                     monthly_count=CASE WHEN generation_usage.month_key=excluded.month_key
                                     THEN generation_usage.monthly_count+1 ELSE 1 END,
                     updated_at=datetime('now')""",
                (user_id, today, daily + 1, mkey, monthly + 1),
            )
            conn.commit()
            return {
                "success": True,
                "daily_used": daily + 1,
                "daily_limit": DAILY_GENERATION_LIMIT,
                "monthly_used": monthly + 1,
                "monthly_limit": MONTHLY_GENERATION_LIMIT,
                "global_used": gcount,
                "global_limit": GLOBAL_DAILY_GENERATION_LIMIT,
                "budget_daily_limit": budget_lim,
                "budget_daily_used": gcount,
            }
        finally:
            conn.close()


def refund_generation(user_id: str) -> None:
    """任务最终失败时回退用户每日/每月额度，便于用户重试。

    注意：不回退 global_usage（全平台每日计数）—— 它是"今日已启动 GPU 的次数"，
    只增不减，作为真正的成本硬线，防止"失败→退款→重试"循环空转付费 GPU。
    """
    if not user_id:
        return
    today, mkey = _today(), _month_key()
    with _DB_LOCK:
        conn = _get_conn()
        try:
            conn.execute(
                """UPDATE generation_usage SET
                     daily_count = MAX(daily_count - 1, 0),
                     monthly_count = MAX(monthly_count - 1, 0),
                     updated_at = datetime('now')
                   WHERE user_id = ? AND date = ? AND month_key = ?""",
                (user_id, today, mkey),
            )
            conn.commit()
        finally:
            conn.close()


async def generation_usage_status(user_id: str) -> dict[str, Any]:
    """查询用户当前生成额度使用情况。"""
    today, mkey = _today(), _month_key()
    with _DB_LOCK:
        conn = _get_conn()
        try:
            row = conn.execute("SELECT * FROM generation_usage WHERE user_id=?", (user_id,)).fetchone()
            g = conn.execute("SELECT count FROM global_usage WHERE date=?", (today,)).fetchone()
            daily = 0
            monthly = 0
            if row:
                if row["date"] == today:
                    daily = row["daily_count"]
                if row["month_key"] == mkey:
                    monthly = row["monthly_count"]
            return {
                "user_id": user_id,
                "daily_used": daily,
                "daily_limit": DAILY_GENERATION_LIMIT,
                "monthly_used": monthly,
                "monthly_limit": MONTHLY_GENERATION_LIMIT,
                "global_daily_used": g["count"] if g else 0,
                "global_daily_limit": GLOBAL_DAILY_GENERATION_LIMIT,
                "budget_daily_limit": budget_daily_limit(),
                "budget_daily_used": g["count"] if g else 0,
            }
        finally:
            conn.close()


